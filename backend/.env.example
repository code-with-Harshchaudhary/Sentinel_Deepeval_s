AXIOM_ENVIRONMENT=development
AXIOM_DATABASE_URL=sqlite:///./axiomeval.db
# Production/Supabase alternative (standard postgres:// and postgresql:// URLs are supported):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Leave blank for the built-in local background runner. Use Redis in deployed environments.
AXIOM_REDIS_URL=
AXIOM_CORS_ORIGINS=http://localhost:5173
AXIOM_JUDGE_MODEL=gpt-6-astra
# Provider keys stay server-side. Never prefix them with VITE_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
